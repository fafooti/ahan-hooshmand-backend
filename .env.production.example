# Production backend environment (copy to .env on the VPS)
NODE_ENV=production
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ahan_db?schema=public"

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Public frontend origin — required for Socket.IO CORS in production
# Use your server IP or domain (no trailing slash)
CORS_ORIGIN=http://YOUR_DOMAIN
FRONTEND_URL=http://YOUR_DOMAIN
