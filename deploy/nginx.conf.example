# Nginx reverse-proxy example for Ubuntu 22.04
# Replace YOUR_DOMAIN with your production domain or server IP.
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/ahan-hooshmand
#   sudo ln -sf /etc/nginx/sites-available/ahan-hooshmand /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Routes:
#   /        → Next.js frontend (port 3001)
#   /api/    → Express API + Socket.IO at /api/socket.io (port 3000)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ahan_hooshmand_api {
    server 127.0.0.1:3000;
    keepalive 64;
}

upstream ahan_hooshmand_frontend {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    server_name YOUR_DOMAIN;

    # Redirect HTTP to HTTPS (uncomment after TLS is configured)
    # return 301 https://$host$request_uri;

    client_max_body_size 10M;

    # Next.js frontend
    location / {
        proxy_pass http://ahan_hooshmand_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Express REST API + Socket.IO (/api/socket.io)
    location /api/ {
        proxy_pass http://ahan_hooshmand_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
}

# HTTPS server block (uncomment and configure after obtaining TLS certificates)
