# Application
NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ahan_hooshmand

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# CORS — comma-separated allowed origins (no wildcards)
CORS_ORIGIN=http://localhost:3000

# Public frontend URL (used as CORS fallback when CORS_ORIGIN is unset)
FRONTEND_URL=http://localhost:3000

# Seed script — required when running npm run prisma:seed
SEED_ADMIN_PASSWORD=change-me-before-seeding

# Frontend (Next.js) — configure in the frontend project .env
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
