# Application
NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/ahan_db?schema=public"

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS — comma-separated allowed origins (no wildcards)
# Development: Next.js on port 3001
CORS_ORIGIN=http://localhost:3001

# Public frontend URL (used as CORS fallback when CORS_ORIGIN is unset)
FRONTEND_URL=http://localhost:3001

# Seed script — required when running npm run prisma:seed
SEED_ADMIN_PASSWORD=Admin123456

# Production: see .env.production.example
